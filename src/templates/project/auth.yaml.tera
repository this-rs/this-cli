# Authentication & Authorization for {{ project_name }}
# Documentation: https://this-rs.github.io/website/#auth
#
# Loaded by ServerBuilder::with_auth_config_file()
#
# ⚠️ LES POLITIQUES DE CE FICHIER SONT APPLIQUÉES PAR DÉFAUT.
#
# Un `ServerBuilder::new()` construit un hôte où `authorize == true` : chaque
# requête vers une route d'entité connue est confrontée à la politique déclarée
# de l'opération, et refusée en 403 si elle ne la satisfait pas. Deux garanties :
#   • fail-closed — une politique illisible, ou une route personnalisée, ne
#     laisse jamais passer par accident (une route inconnue s'abstient : c'est
#     la couche d'authentification globale qui reste juge) ;
#   • vocabulaire clos — un mot hors vocabulaire (`"admin"` au lieu de
#     `admin_only`, `"PUBLIC"`, une faute de frappe) est REFUSÉ, jamais replié
#     sur « authenticated ».
#
# La politique par défaut d'une entité est `authenticated` : une entité sans
# configuration explicite EXIGE donc un contexte authentifié. C'est voulu.
#
# Pour un service réellement public (dégradation délibérée, journalisée) :
#     ServerBuilder::new().without_authorization()

# Provider: wami (WAMI STS), oidc (external OIDC), none (disabled)
provider: wami

# Default policy for entity endpoints: public, authenticated, admin_only
default_policy: authenticated

# WAMI-specific configuration
wami:
  # bootstrap mode: auto-generates Ed25519 key pair at startup (dev-friendly)
  # Switch to 'embedded' with explicit keys for production
  mode: bootstrap
  # public_key: "MCowBQYDK2VwAyEA..."  # Required in embedded/sts mode
  token_ttl_secs: 900
  refresh_ttl_secs: 3600

# Per-entity policy overrides (optional)
# Built-in policies: public, authenticated, owner, admin_only, service_only
# Role-based: "role:editor", "owner_or_role:admin"
# Custom resolvers: "resolver:is_delegated", "owner_or_resolver:is_parent"
#   → Register resolvers in ServerBuilder: .with_auth_resolver("is_delegated", ...)
# Statements (composable):
#   "all:authenticated,resolver:is_group_member"    — AND: all must pass
#   "any:owner,resolver:is_delegated,role:admin"    — OR:  any must pass
#   "all:authenticated,not:resolver:is_readonly"    — NOT: deny list
# Décision IAM matérialisée (obrain) : "perm:orders:write"
#   → tranchée par la décision indexée du couple (principal, portée), dérivé du
#     contexte : User/Owner → (user_id, tenant_id), Service → (service_name,
#     tenant_id), Admin → (admin_id, "global"). Un contexte sans principal
#     (anonyme) est REFUSÉ, et une politique `perm:` non tranchable refuse aussi
#     sous `not:` — une liste de refus n'est jamais une liste d'admission.
# entities:
#   order:
#     list: authenticated
#     get: authenticated
#     create: "resolver:is_manager"
#     update: "owner_or_resolver:is_delegated"
#     delete: admin_only
#   user:
#     read: authenticated
#     write: admin_only

# Multi-tenant configuration
tenant:
  enabled: true
  # JWT claim to extract tenant_id from
  claim_field: tenant_id
  # Auto-create tenant on first request
  auto_provision: true

# GDPR compliance
gdpr:
  # Enable DELETE /tenants/:tenant_id/data endpoint
  erasure_cascade: true
  # Audit sink for erasure events (logs before deletion)
  # audit_sink: webhook

# Event scoping
events:
  # Events are filtered by tenant_id
  tenant_isolation: true
{% if cognitive %}
  # Enable cognitive signal bridge (works with any backend)
  cognitive_bridge: true
  cognitive_notifications: true
{% endif %}
