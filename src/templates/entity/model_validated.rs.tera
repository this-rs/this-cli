use this::prelude::*;

{# Rendered from the entity descriptor: `model` = ModelRender::from_entity(EntityDesc)
   (src/descriptor/from_fields.rs). Each rule line is the macro spelling of a
   ValidatorRule / TransformRule; an `always` rule appears in create AND update. #}
impl_data_entity_validated!(
    {{ entity_pascal }},
    "{{ entity_name }}",
    [{% for field in indexed_fields %}"{{ field }}"{% if not loop.last %}, {% endif %}{% endfor %}],
    {
{% for field in fields %}        {{ field.name }}: {{ field.rust_type }},
{% endfor %}    },
    validate: {
        create: {
{% if model is defined %}{% for line in model.validate.create %}            {{ line.field }}: [{{ line.rules }}],
{% endfor %}{% endif %}        },
        update: {
{% if model is defined %}{% for line in model.validate.update %}            {{ line.field }}: [{{ line.rules }}],
{% endfor %}{% endif %}        },
    },
    filters: {
        create: {
{% if model is defined %}{% for line in model.filters.create %}            {{ line.field }}: [{{ line.rules }}],
{% endfor %}{% endif %}        },
        update: {
{% if model is defined %}{% for line in model.filters.update %}            {{ line.field }}: [{{ line.rules }}],
{% endfor %}{% endif %}        },
    }
);
{% include "entity/described.rs" %}
