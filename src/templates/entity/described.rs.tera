{# Shared tail of entity/model.rs and entity/model_validated.rs (descriptor mode).
   The merge below is the one `src/descriptor/code.rs::merge_extra` performs when the CLI
   reads the model back (generated_descriptor_matches_code). #}{% if described is defined and described %}
/// Rules the macro grammar cannot carry (email, url, pattern, min_value, query filters,
/// read_only...), declared by `this add entity --fields`. JSON array of partial
/// `FieldDesc`; read back by `this descriptor export` / `this doctor`.
const DESCRIBED_EXTRA: &str = r{{ model.extra_hashes }}"{% if model.extra_json %}{{ model.extra_json }}{% else %}[]{% endif %}"{{ model.extra_hashes }};

/// Descriptor of `{{ entity_pascal }}`: the macro's (types, plural, rules of its grammar)
/// plus `DESCRIBED_EXTRA`. Composed with `descriptor/module.yaml` by
/// `Module::descriptor()` (src/module.rs).
pub fn described() -> this::descriptor::EntityDesc {
    let mut e = {{ entity_pascal }}::descriptor().clone();
    let extra: Vec<this::descriptor::FieldDesc> =
        serde_json::from_str(DESCRIBED_EXTRA).expect("DESCRIBED_EXTRA is valid JSON");
    for x in extra {
        let f = e
            .field_or_overlay_mut(&x.name)
            .unwrap_or_else(|| panic!("DESCRIBED_EXTRA: `{}` is not a field of {{ entity_name }}", x.name));
        f.validators.extend(x.validators);
        f.transforms.extend(x.transforms);
        for op in x.filterable {
            if !f.filterable.contains(&op) {
                f.filterable.push(op);
            }
        }
        f.sortable |= x.sortable;
        f.read_only |= x.read_only;
        f.immutable |= x.immutable;
    }
    e.normalize();
    e
}
{% endif %}