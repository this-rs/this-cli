import { useEffect, useState } from "react";

function App() {
  const [status, setStatus] = useState<string>("loading...");

  useEffect(() => {
    // `/health` stays REST: it is a probe, not a data operation.
    //
    // Entity calls go through **gRPC-Web** — the generated server exposes it on the same
    // port as REST (tonic-web layer). A browser cannot speak gRPC (HTTP/2 binary), so the
    // front frames requests as gRPC-Web: one 5-byte header per message, decoded frames in
    // return. REST remains available for scripts and curl.
    fetch("/health")
      .then((res) => (res.ok ? "connected" : "error"))
      .then(setStatus)
      .catch(() => setStatus("offline"));
  }, []);

  return (
    <div className="app">
      <header>
        <h1>{{ project_name }}</h1>
        <p>
          API status: <span className={`status ${status}`}>{status}</span>
        </p>
      </header>
      <main>
        <p>
          Edit <code>src/App.tsx</code> and save to reload.
        </p>
      </main>
    </div>
  );
}

export default App;
